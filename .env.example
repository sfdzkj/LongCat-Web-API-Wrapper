# LongCat API Configuration
# Optional model/agent for session creation
LONGCAT_MODEL=
LONGCAT_AGENT_ID=

LONGCAT_API_URL=https://longcat.chat/api/v1/chat-completion
LONGCAT_SESSION_URL=https://longcat.chat/api/v1/session-create

# Cookie Values (REQUIRED - Replace with your actual values)
# To get these values:
# 1. Login to longcat.chat in your browser
# 2. Open Developer Tools (F12)
# 3. Go to Application/Storage -> Cookies
# 4. Copy the values for these cookies
COOKIE_LXSDK_CUID=your_lxsdk_cuid_value_here
COOKIE_PASSPORT_TOKEN=your_passport_token_here
COOKIE_LXSDK_S=your_lxsdk_s_value_here

# Server Configuration
SERVER_PORT=8082

# Optional Configuration
# TIMEOUT_SECONDS=30
# Request model enum (controls mode): LongCat-Chat | LongCat-Thinking | LongCat-Search | LongCat-Search-Thinking

# Optional auth key for this wrapper; leave empty to disable auth
UPSTREAM_API_KEY=

# CORS allow origin(s)
CORS_ALLOW_ORIGINS=*

# Bind address (default 0.0.0.0 for external access)
BIND_ADDR=0.0.0.0
